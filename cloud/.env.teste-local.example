# Nuvem em TESTE LOCAL. Copie para .env.teste-local (mesma pasta) e preencha.
# NUNCA versione o .env.teste-local real. Use valores DIFERENTES dos da VPS.
# Gere senhas/segredos com: python -c "import secrets; print(secrets.token_urlsafe(48))"

POSTGRES_PASSWORD=

# ---------------- Portal de relatórios (login Google) ----------------
# Login Postgres somente leitura. Com postgres + api no ar, rode:
#   docker compose -f docker-compose.teste-local.yml --env-file .env.teste-local exec api python -m app.admin criar-login-portal
# e cole aqui a senha exibida.
PORTAL_DB_USER=portal
PORTAL_DB_PASSWORD=

# Segredo do cookie de sessão (>= 32 caracteres)
PORTAL_COOKIE_SECRET=

# Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth (Aplicativo da Web)
# URI de redirecionamento autorizado: http://localhost:8502/oauth2callback
# Recomendado: uma credencial só para testes, separada da de produção.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
