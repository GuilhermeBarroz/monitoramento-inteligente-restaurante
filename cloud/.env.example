# Copie para .env e ajuste. NUNCA versione o .env real.
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-aleatoria

# Domínio público da API de ingestão (DNS apontando para a VPS)
API_DOMAIN=api.seudominio.com.br

# ---------------- Portal de relatórios (login Google) ----------------
# Domínio público do portal (DNS apontando para a VPS)
PORTAL_DOMAIN=relatorios.seudominio.com.br
# Login Postgres somente leitura: rode `docker compose exec api python -m app.admin criar-login-portal`
# e cole aqui a senha exibida (ou defina antes e rode o comando com ela no ambiente)
PORTAL_DB_USER=portal
PORTAL_DB_PASSWORD=
# Segredo do cookie de sessão (>= 32 caracteres). Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
PORTAL_COOKIE_SECRET=
# Google Cloud Console > APIs e serviços > Credenciais > ID do cliente OAuth (Aplicativo da Web)
# URI de redirecionamento autorizado: https://<PORTAL_DOMAIN>/oauth2callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Integração com o Traefik já existente na VPS
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
