# Arquivos executados no Mini PC Linux precisam de fim de linha LF,
# mesmo quando o repositório é clonado/editado no Windows.
*.sh              text eol=lf
Dockerfile        text eol=lf
.dockerignore     text eol=lf
.env.example      text eol=lf
*.yml             text eol=lf
*.py              text eol=lf
requirements*.txt text eol=lf
