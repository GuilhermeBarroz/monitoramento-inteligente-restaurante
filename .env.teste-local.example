# Edge em TESTE LOCAL (usado com docker-compose.teste-local.yml).
# Copie para .env.teste-local (mesma pasta) e preencha. NUNCA versione o real.
# CLOUD_API_URL e CLOUD_PERMITIR_HTTP já são definidos pelo override de teste.

# Token gerado na nuvem LOCAL:
#   cd cloud
#   docker compose -f docker-compose.teste-local.yml --env-file .env.teste-local exec api python -m app.admin criar-estabelecimento "Restaurante Teste"
EDGE_TOKEN=

# Intervalo entre envios (segundos, mínimo 10). Menor que o real para acompanhar o teste.
SYNC_INTERVALO_SEG=30

# PIN do painel local (mínimo 6 caracteres)
PAINEL_ADMIN_PIN=
