# Copie para .env (mesma pasta do docker-compose.yml) e preencha. NUNCA versione o .env real.
# Endereço da API de ingestão na nuvem e token deste restaurante
# (gerado na VPS com: docker compose exec api python -m app.admin criar-estabelecimento "Nome")
CLOUD_API_URL=https://api.seudominio.com.br
EDGE_TOKEN=
SYNC_INTERVALO_SEG=60

# PIN do administrador do painel local (câmeras, imagens ao vivo, calibração,
# regras e relatórios). Mínimo 6 caracteres. O install.sh gera um aleatório.
# Sem PIN, essas áreas ficam bloqueadas; a visão do salão e os eventos seguem abertos.
PAINEL_ADMIN_PIN=

# Interface em que o painel escuta. Padrão 0.0.0.0 (todas). Para restringir,
# use o IP do Mini PC na LAN do restaurante ou o IP 100.x do Tailscale.
# PAINEL_BIND_IP=192.168.1.50
